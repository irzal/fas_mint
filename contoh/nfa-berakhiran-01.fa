type: NFA
# NFA: string biner berakhiran 01 (spesifikasi bagian 8.2)
# Bandingkan dengan berakhiran-01.dfa: NFA cukup "menebak" kapan 01 terakhir dimulai.
states: q0 q1 q2
alphabet: 0 1
start: q0
accept: q2

q0 0 -> {q0, q1}    # menebak: mungkin 0 ini awal dari 01 terakhir
q0 1 -> q0
q1 1 -> q2
# δ(q1, 0), δ(q2, 0), dan δ(q2, 1) tidak ditulis: hasilnya ∅
