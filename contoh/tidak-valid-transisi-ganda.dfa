# SENGAJA SALAH (spesifikasi bagian 6): melanggar V6b.
# Dua transisi untuk pasangan (q0, 0) adalah ciri NFA, bukan DFA.
# Validator akan melaporkan: δ(q0, 0) didefinisikan dua kali, itu bukan DFA
states: q0 q1
alphabet: 0 1
start: q0
accept: q1

q0 0 -> q0
q0 0 -> q1
q0 1 -> q0
q1 0 -> q1
q1 1 -> q1
