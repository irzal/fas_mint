# DFA: bilangan biner yang habis dibagi 3 (dibaca dari bit paling kiri)
# state r0, r1, r2 = sisa bagi 3 dari bilangan yang sudah dibaca
# membaca bit b: sisa baru = (2 x sisa lama + b) mod 3
states: r0 r1 r2
alphabet: 0 1
start: r0
accept: r0

r0 0 -> r0
r0 1 -> r1
r1 0 -> r2
r1 1 -> r0
r2 0 -> r1
r2 1 -> r2
